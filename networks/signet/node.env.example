# Signet lab — public writer at https://signet.kray.network
# Copy into gitignored /signet/node-hot.env on the writer host. Never commit secrets.
# The owner secret stays on the key machine (/signet/vault-keys.env or /signet/owner.box).

KRAY_NET=signet
KRAY_PORT=4478
KRAY_BIND=127.0.0.1
KRAY_PUBLIC=1
KRAY_DATA=apps/kray-net/data-signet
KRAY_TRUSTED_DEV=0

# This lab's Signet bitcoind + ord — never mainnet :8332
KRAY_BTC_RPC=http://127.0.0.1:38332
KRAY_BTC_RPC_USER=
KRAY_BTC_RPC_PASS=
KRAY_BTC_WALLET=kray-anchor
KRAY_ORD_URL=http://127.0.0.1:8083

# Signet bakery (tb1…). Never a bc1 mainnet vault.
KRAY_POT_ADDRESS=
