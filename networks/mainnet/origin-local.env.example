# Origin-only overlay. Copy to gitignored /mainnet/origin-local.env ON Origin.
# Holds THIS machine's bitcoin.conf RPC + the ord / Kray API already running here.
# Never vault-keys. Never Signet RPC :38332. Later keys win over node-hot.env.

KRAY_BTC_RPC=http://127.0.0.1:8332
KRAY_BTC_RPC_USER=
KRAY_BTC_RPC_PASS=
KRAY_BTC_WALLET=kray-fee
KRAY_ORD_URL=http://127.0.0.1:80
KRAY_API_ENDPOINT=
