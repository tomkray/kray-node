# Bitcoin mainnet — public writer at https://www.kray.network
# Copy into gitignored /mainnet/node-hot.env WHEN the operator ignites.
# This file is the recipe for the WHOLE L2 (donate + rune bridge + exit).
# It is not ignition. Do not start the writer from it.
# Never commit secrets. Never copy Signet journal, Signet vault, or Signet node-hot.env.
# Never put KRAY_CONSOLIDATION_SECRET or KRAY_VAULT_GUARDIAN_SECRETS on this writer.

# ── universe (locked) ────────────────────────────────────────────────────────
KRAY_NET=main
KRAY_PORT=4478
KRAY_BIND=127.0.0.1
KRAY_PUBLIC=1
KRAY_DATA=apps/kray-net/data-main
KRAY_TRUSTED_DEV=0
KRAY_SELF_URL=https://www.kray.network

# ── L1 oracle — required. Writer refuses :18454 (regtest) and :38332 (Signet).
# bitcoind MUST be Bitcoin mainnet. ord MUST index that same chain.
KRAY_BTC_RPC=http://127.0.0.1:8332
KRAY_BTC_RPC_USER=
KRAY_BTC_RPC_PASS=
KRAY_BTC_WALLET=kray-fee
KRAY_ORD_URL=http://127.0.0.1:80
KRAY_MEMPOOL_API=https://mempool.space/api
KRAY_DONATION_CONF=6

# ── rune-bridge pot = the consolidation vault (MUST equal deriveVault of the pubs below)
# A rune deposit that does not pay THIS script is refused. Never a tb1. Never Signet's pot.
# This is NOT the donate destination. Donate/₭ burns at the NUMS self-anchor below.
KRAY_POT_ADDRESS=

# ── bridge federation (set at GENESIS — changing later changes every vault address)
KRAY_CONSOLIDATION_KEY=
KRAY_VAULT_GUARDIANS=
KRAY_VAULT_THRESHOLD=2
KRAY_VAULT_TIMELOCK=4320

# Two pens, two holes. Same owner.box. Never two binds on one port. Never :4479.
# Primary hole :4579. Fallback spare :4580. Writer asks ONE — primary if alive.
KRAY_POT_SIGNER_URL=http://127.0.0.1:4579
KRAY_POT_SIGNER_URL_FALLBACK=http://127.0.0.1:4580
KRAY_POT_SIGNER_TOKEN=

# Book-checking guardians ON from day one. Mainnet refuses lab guardian secrets.
# Ports 4491–4493 — never 4481 (that port is follower-main, FOLDER-LAW).
KRAY_GUARDIAN_SIGNER_URLS=http://127.0.0.1:4491,http://127.0.0.1:4492,http://127.0.0.1:4493
KRAY_GUARDIAN_SIGNER_TOKEN=

# ── consensus doors (ON). Force =0 only to replay a proofless past — never on a live main writer.
KRAY_CONSENSUS_BURN_PROOF=1
KRAY_CONSENSUS_RUNE_PROOF=1
KRAY_BACKING_GATE=1

# ── donate / ₭ = keyless NUMS burn (same door as Signet). The output IS the anchor.
# BURN_INTERNAL_KEY = SHA256(uncompressed G) — BIP-341. Nobody has the discrete log.
# Never put the vault / consolidation key here (pot-key self-anchor = custody + follower weight-zero).
KRAY_SELF_ANCHOR=1
KRAY_POT_INTERNAL_KEY=50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0
KRAY_OPERATOR_ANCHOR=0

# ── wallet seat (already wired; do NOT announce / do NOT ship an "it's live" zip)
# KrayWallet DevNet OFF → https://www.kray.network
# Igniting the writer IS the public launch.
