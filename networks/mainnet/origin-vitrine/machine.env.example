# THE file you edit when this house moves to another machine.
# Copy to hot\machine.env. Later keys win over origin-local.env.
# Never vault-keys. Never owner.box. Never KRAY_CONSOLIDATION_SECRET.
#
# Change these. Leave everything else alone.

KRAY_VITRINE_ROOT=C:\kray-network-vitrine
KRAY_BIND=127.0.0.1
KRAY_PORT=4478

# THIS machine's bitcoin.conf + the ord / Kray API already running here.
KRAY_BTC_RPC=http://127.0.0.1:8332
KRAY_BTC_RPC_USER=
KRAY_BTC_RPC_PASS=
KRAY_BTC_WALLET=kray-fee
KRAY_ORD_URL=http://127.0.0.1:80
KRAY_API_ENDPOINT=
