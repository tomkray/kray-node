# Writer vitrine — Cloudflare named tunnel (THIS disk).
# Copy to <root>\run\cloudflared.yml
# Fill tunnel + credentials-file from THIS machine's Cloudflare account.
# When the house moves, this file is the second edit (after hot\machine.env).
# Never commit the credentials JSON.
#
#   cloudflared tunnel --config C:\kray-network-vitrine\run\cloudflared.yml run

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: C:\kray-network-vitrine\run\credentials.json

ingress:
  - hostname: www.kray.network
    service: http://127.0.0.1:4478
  - hostname: kray.network
    service: http://127.0.0.1:4478
  - service: http_status:404
