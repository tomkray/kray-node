apps/kray-net/regtest-harness/

# live test harnesses hold the node's Bitcoin RPC password — NEVER source
apps/kray-net/signet-harness/
signet-harness/
# reset/backup universes moved aside on a data reset — history on disk, never git
apps/kray-net/data-v2.bak*/
apps/kray-net/data-v2.reset-bak*/
data-v2.bak*/
data-v2.reset-bak*/

# any backup file, anywhere — a .bak is never source
*.bak
