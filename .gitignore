networks/mainnet/origin-local.env.example

# Private scroll — keep on this disk, never the public door
manifesto/

# External tenants (KRILL, Radiola, Satspace, Station, …) — other houses, not this node
apps/kray-core/src/adapter/

# Workshop leftover — official tree must not grow exam/lab (house detector)
scripts/exam/
scripts/lab/

# Operator RUN-LAYER on this disk — never the public door (machine names, tunnels, vault generators)
scripts/operator/
