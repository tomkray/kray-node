apps/kray-fold/proofs/breath-*.groth16.json

# L1 Bitcoin/ord gateway — this machine's oracle, not the ledger strangers clone
apps/kray-api/

# Operator RUN-LAYER — your machine-specific launch wrappers/units, NOT the public consensus
# tree. Keep these gitignored so a code update (checkout/pull) never removes your node's own
# launch wrapper. Your run-layer is yours; it never affects consensus.
bin/
.oss-guard-local

# The Creator's desk — living chronology, inscription workbook, artist roster.
# Follow never needs these. They stay on this disk. Never the public door.
apps/kray-net/later/
apps/kray-net/works/
apps/kray-net/PARENTS.md
apps/kray-net/library/MANIFEST.md
